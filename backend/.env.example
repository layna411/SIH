APP_NAME=EduResolve AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# XAMPP MySQL Database Configuration
# Set MYSQL_PORT to your actual XAMPP MySQL port (default 3306, or your custom configured port)
# Set MYSQL_PASSWORD if a password was set for root in phpMyAdmin
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=eduresolve_ai
# Optional explicit DATABASE_URL (must use mysql+pymysql://)
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/eduresolve_ai?charset=utf8mb4

# Dedicated Test Database on XAMPP MySQL
MYSQL_TEST_DATABASE=eduresolve_ai_test

# JWT Security
JWT_SECRET_KEY=replace_with_a_secure_random_secret_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS
FRONTEND_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# File Storage
UPLOAD_DIR=private_uploads
MAX_UPLOAD_SIZE_MB=10

# AI Provider ("local", "rule_based", "openai", "none")
AI_PROVIDER=local
AI_API_KEY=

# SMTP Email Configuration (Optional - fallback to console logger in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@eduresolve.ai
SMTP_USE_TLS=true
NOTIFICATION_EMAIL_ENABLED=true
FRONTEND_URL=http://localhost:5173

# Email Verification & Resend Cooldown
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Reliable Notification Outbox
NOTIFICATION_OUTBOX_MAX_RETRIES=5

# SLA Background Scheduler & Monitoring
SLA_SCHEDULER_ENABLED=true
SLA_POLL_INTERVAL_SECONDS=300
SLA_WARNING_HOURS=24
AICTE_ALERT_WARNING_HOURS=48
AICTE_ALERT_DEDUP_HOURS=24
AICTE_TRANSFER_PENDING_WARNING_HOURS=72

# Security Safeguards & Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_REGISTER_MAX_REQUESTS=5
RATE_LIMIT_VERIFY_RESEND_MAX_REQUESTS=3
MAX_CONTENT_LENGTH_MB=15

